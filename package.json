{
	"name": "gateway",
	"private": true,
	"type": "module",
	"scripts": {
		"start": "tsx --env-file=.env src/index.ts",
		"dev": "tsx watch --env-file=.env src/index.ts",
		"format": "oxfmt --write .",
		"lint": "oxlint --fix .",
		"schema/push": "drizzle-kit push",
		"schema/generate": "drizzle-kit generate",
		"schema/migrate": "drizzle-kit migrate"
	},
	"dependencies": {
		"@discordeno/bot": "^21.0.0",
		"@discordeno/gateway": "^21.0.0",
		"@discordeno/rest": "^21.0.0",
		"better-sqlite3": "^13.0.3",
		"cron-schedule": "^6.0.0",
		"discord-api-types": "^0.38.57",
		"drizzle-orm": "^0.45.4",
		"tsx": "^4.23.15"
	},
	"devDependencies": {
		"@types/better-sqlite3": "^9.6.0",
		"@types/node": "^26.6.5",
		"drizzle-kit": "^0.31.11",
		"oxfmt": "^0.74.0",
		"oxlint": "^1.89.0",
		"typescript": "^7.0.2"
	}
}
